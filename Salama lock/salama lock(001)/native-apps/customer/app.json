{
  "expo": {
    "name": "Salama Lock Customer",
    "slug": "salama-lock-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B4F3C"
    },
    "android": {
      "package": "com.salamalock.customer",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0B4F3C"
      },
      "permissions": []
    },
    "plugins": [
      "expo-secure-store",
      ["expo-image-picker", {
        "photosPermission": "Allow Salama Lock Customer to select an optional profile photo."
      }]
    ]
  }
}
